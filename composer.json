{
    "name": "victor78/zippy-ext",
    "type": "zippy-extension",
    "description": "The 7-Zip integration for the Zippy.",
    "keywords": ["zippy", "7zip", "7-zip", "archiver", "archivator", "archive", "zip"],
    "license": "MIT",
    "authors": [
        {
            "name": "Victor78",
            "homepage": "http://victor78.com/"
        }
    ],
    "support": {
        "issues": "https://github.com/victor78/ZippyExt/issues",
        "wiki": "https://github.com/victor78/ZippyExt/wiki",
        "source": "https://github.com/victor78/ZippyExt"
    },

    "require": {
        "php": ">=8.1",
        "alchemy/zippy": "^1.0",
        "symfony/process": "^5.4.51|^6.0|^7.0"
    },

    "autoload": {
        "psr-4": {
            "Victor78\\ZippyExt\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    }
}
